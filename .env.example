# ─────────────────────────────────────────────────
# LLM Provider 선택 (필수)
# ─────────────────────────────────────────────────
# openai | anthropic | gemini 중 하나 선택
LLM_PROVIDER=openai

# ─────────────────────────────────────────────────
# API Keys — 사용하는 provider 키만 입력하면 됨
# ─────────────────────────────────────────────────

# OpenAI (gpt-4o-mini 기본)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic / Claude (claude-sonnet-4-6 기본)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini (gemini-2.0-flash 기본)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────────
# KRX 데이터포탈 인증 (선택 — 투자자 동향·PER/PBR 활성화)
# data.krx.co.kr 무료 회원가입 후 입력
# 없으면 OHLCV·뉴스 기반으로만 동작 (fallback)
# ─────────────────────────────────────────────────
# KRX_ID=가입한_아이디
# KRX_PW=가입한_비밀번호

# ─────────────────────────────────────────────────
# 선택: 모델 오버라이드
# ─────────────────────────────────────────────────
# FINAGENT_MODEL=gpt-4o-mini
